<?xml version="1.0" encoding="utf-8"?>
<!-- Open snus can with a rectangular pouch standing in it, a thick lid leaning on the rim and tally
     marks on the wall. Drawn on a 108 grid, then scaled into the adaptive-icon safe zone. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <group
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:pivotX="54"
        android:pivotY="54"
        android:translateX="-5">
        <!-- pouch -->
        <group android:rotation="-15" android:pivotX="40" android:pivotY="67">
            <path
                android:pathData="M31,67 V21 a3,3 0 0,1 3,-3 H46 a3,3 0 0,1 3,3 V67"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="6"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
        <!-- can rim and body -->
        <path
            android:pathData="M14,58 a30,11 0 1,0 60,0 a30,11 0 1,0 -60,0 Z"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <path
            android:pathData="M14,58 V78 a30,11 0 0,0 60,0 V58"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
        <!-- tally marks -->
        <path
            android:pathData="M36.5,73 V83 M41.5,73 V83 M46.5,73 V83 M51.5,73 V83 M33,84 L55,72"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="4"
            android:strokeLineCap="round" />
        <!-- lid -->
        <group android:rotation="-35" android:pivotX="87" android:pivotY="43">
            <path
                android:pathData="M63,43 a24,9 0 1,0 48,0 a24,9 0 1,0 -48,0 Z"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="6"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
            <path
                android:pathData="M63,43 v7 a24,9 0 0,0 48,0 v-7"
                android:strokeColor="#FFFFFFFF"
                android:strokeWidth="6"
                android:strokeLineCap="round"
                android:strokeLineJoin="round" />
        </group>
    </group>
</vector>
